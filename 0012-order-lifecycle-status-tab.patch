@@ -0,0 +1,26 @@
+import 'package:flutter/material.dart';
+
+import '../theme/app_spacing.dart' show AppRadius;
+
+/// Small status/tag badge — per `component-standards.md` Section 6:
+/// `AppRadius.sm`, padding horizontal 8 / vertical 4, font size 10 /
+/// w800 / letterSpacing 0.2–0.3, background is [color] at 8–10% opacity
+/// with [color] itself as the text color. Existing badges
+/// (`transaction_card.dart`) wrote this pattern manually per status;
+/// this widget exists so it's written once and called per status
+/// instead.
+class AppStatusBadge extends StatelessWidget {
+  final String label;
+  final Color color;
+
+  const AppStatusBadge({super.key, required this.label, required this.color});
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
+      decoration: BoxDecoration(color: color.withValues(alpha: 0.1), borderRadius: BorderRadius.circular(AppRadius.sm)),
+      child: Text(label, style: TextStyle(fontSize: 10, fontWeight: FontWeight.w800, color: color, letterSpacing: 0.3)),
+    );
+  }
+}
